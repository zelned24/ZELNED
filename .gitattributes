# Normalize line endings
* text=auto

# Force LF for C/C++ and Python (Unix tools)
*.c    text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.py   text eol=lf
Makefile text eol=lf

# Force CRLF for Windows-specific files
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary files
*.3dsx binary
*.cia  binary
*.elf  binary
